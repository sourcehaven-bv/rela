              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "more": {
                      "type": "integer",
                      "description": "Viewers past the 20 listed"
                    },
                    "viewers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "since": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "tool": {
                            "type": "string"
                          },
                          "user": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "user",
                          "tool",
                          "since"
                        ]
                      }
                    }
                  },
                  "required": [
                    "viewers",
                    "more"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID, or ID@face",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "world",
          "in": "query",
          "description": "World that picks the face",
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/policies/{id}/mentioned-by": {
      "get": {
        "operationId": "getPolicyMentionedBy",
