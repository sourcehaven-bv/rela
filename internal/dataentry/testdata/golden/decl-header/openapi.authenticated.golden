                        "title"
                      ]
                    },
                    "relations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": "Outgoing relations by type"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
