                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "Precondition failed (ETag mismatch)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePolicy",
        "summary": "Delete a Policy",
        "tags": [
          "Policy"
        ],
        "responses": {
          "204": {
            "description": "Entity deleted"
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Cannot delete: the entity has incoming relations, a channel whose type sets on_entity_delete: block is attached (code channel_blocks_delete), or the entity changed during the delete (code conflict; retry)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/policies/{id}/_actions/clone": {
      "post": {
        "operationId": "clonePolicy",
        "summary": "Clone a Policy",
        "description": "Creates a copy of the entity with a new ID",
        "tags": [
          "Policy"
        ],
        "responses": {
          "201": {
            "description": "Cloned Policy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_actions": {
                      "$ref": "#/components/schemas/EntityActions"
                    },
                    "_attachments": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Attachment"
                        }
                      },
                      "description": "Attached files by file property"
                    },
                    "_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Operator-declared entity type conversions offered from this entity"
                    },
                    "_copies": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Copy definitions offered from this face (promote, translate)"
                    },
                    "_faces": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "The other faces of this entity the reader may see"
                    },
                    "_fields": {
                      "type": "object",
                      "description": "Per-property write affordances for this reader"
                    },
                    "_lease": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "since": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "type": "string"
                        },
                        "tool": {
                          "type": "string"
                        },
                        "user": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "tool",
                        "since"
                      ],
                      "description": "The advisory lease on this entity; absent when nobody holds it"
                    },
                    "_owner": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "relation": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "description": "The entity this one is shown as part of, through an owning relation"
                    },
                    "_redacted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Properties withheld from this reader; absent when nothing is withheld"
                    },
                    "_relations": {
                      "type": "object",
                      "description": "Per-relation-type write affordances for this reader"
                    },
                    "_self": {
                      "type": "string",
                      "format": "uri-reference",
                      "description": "Self link"
                    },
                    "_task_item_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Recipes that turn a task item in this entity's body into a linked entity"
                    },
                    "_title": {
                      "type": "string",
                      "description": "Display title, resolved from the type's display property"
                    },
                    "_transitions": {
                      "type": "object",
                      "description": "Outgoing state-machine transitions per property, for this reader"
                    },
                    "_versions": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "Version token per field, for a PATCH with preconditions"
                    },
                    "_world": {
                      "type": "object",
                      "description": "Which world resolved this face, and how (single-entity GET only)"
                    },
                    "content": {
                      "type": "string",
                      "description": "Markdown body content"
                    },
                    "id": {
                      "type": "string",
                      "description": "Unique entity identifier"
                    },
                    "inaccessible": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Properties that exist but whose value cannot be read (locked content)"
                    },
                    "included": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Entity"
                      },
                      "description": "Sideloaded related entities"
                    },
                    "mentions": {
                      "type": "object",
                      "description": "Titles of the entity IDs referenced in content (single-entity GET only)"
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "stage": {
                          "type": "string",
                          "enum": [
                            "to-do",
                            "done"
                          ]
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title"
                      ]
                    },
                    "relations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": "Outgoing relations by type"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "policy"
                      ],
                      "description": "Entity type"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Soft validation findings from the write that produced this response"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "title": "Policy"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of cloned entity",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/policies/{id}/_lease": {
      "post": {
        "operationId": "claimPolicy",
        "summary": "Claim an advisory lease on a Policy",
        "description": "Tells people and agents you are working on the entity. Needs read and update access. Leases do not block writes. Keep lease_id: it is returned only here, and POST /api/v1/_leases/renew and POST /api/v1/_leases/release need it.",
        "tags": [
          "Policy"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Tells apart agents running as the same user"
                  },
                  "status": {
                    "type": "string",
                    "description": "Short note on what you are doing"
                  },
                  "ttl_seconds": {
                    "type": "integer",
                    "description": "Lease duration, 30 to 3600 (default 900)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lease claimed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "lease_id": {
                      "type": "string"
                    },
                    "token": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "lease_id",
                    "token",
                    "expires_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, an unknown field, or invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed to update the entity, or no signed-in user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The entity is held (lease_held, naming the holder), or you hold too many leases (lease_limit)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "holder": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string"
                            },
                            "tool": {
                              "type": "string"
                            },
                            "user": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "user",
                            "tool"
                          ]
                        },
                        "since": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    }
                  ],
                  "description": "A problem. When the type ends in lease_held, it also names the holder and the live lease; a lease_limit problem has the problem fields only."
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "A bare id of a faced type; address one face",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The lease store is full; retry later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID, or ID@face",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/policies/{id}/_presence": {
      "get": {
        "operationId": "getPresencePolicy",
        "summary": "List who else has a Policy open",
        "description": "The other people with a live subscription to this path, oldest first, at most 20. A viewer stays listed for 15 seconds after they close it. You are never listed, from any tool. This GET does not add you; subscribe to the path on the live event stream for that.",
        "tags": [
          "Policy"
        ],
        "responses": {
          "200": {
            "description": "The viewers",
