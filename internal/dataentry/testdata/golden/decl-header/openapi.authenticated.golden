    "/api/v1/tickets": {
      "summary": "Collection of Ticket entities",
      "get": {
        "operationId": "listTickets",
        "summary": "List Tickets",
        "tags": [
          "Ticket"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page (default: 25, max: 100)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort fields (comma-separated, prefix with - for descending)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[property]",
            "in": "query",
            "description": "Filter by property value (e.g., filter[status]=active)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[property][operator]",
            "in": "query",
            "description": "Filter with operator: eq, ne, contains, in",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_content",
            "in": "query",
            "description": "Include each row's markdown body (default: false; collection rows are content-free)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "relation",
            "in": "query",
            "description": "Canonical relation type; with direction=incoming, each row carries `linkable`: whether the caller may create that relation from the row's face",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Required with relation; only `incoming` is accepted",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of Tickets",
