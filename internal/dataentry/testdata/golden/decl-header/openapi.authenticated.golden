request: GET /api/v1/_openapi.json
identity: a header login for each authenticated principal, all answered alike
status: 200
reads: GraphQueryHeaders=1 ListRelations=1
breadth: ListRelations=0/1
bodies: GraphQuery=0/1
versions: 
body:
{
  "openapi": "3.1.0",
  "info": {
    "title": "Golden parity API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/_leases": {
      "get": {
        "operationId": "listOwnLeases",
        "summary": "List your advisory leases",
        "description": "Your live leases on entities you may read now, oldest first. Lease ids are not returned.",
        "tags": [
          "Leases"
        ],
        "responses": {
          "200": {
            "description": "Your leases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "expires_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "id": {
                            "type": "string",
                            "description": "Entity ID"
                          },
                          "label": {
                            "type": "string"
                          },
                          "since": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "status": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "since",
                          "expires_at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "No signed-in user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/_leases/release": {
      "post": {
        "operationId": "releaseLease",
        "summary": "Release an advisory lease",
        "description": "Answers 204 whether or not you held the lease.",
        "tags": [
          "Leases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lease_id": {
                    "type": "string",
                    "description": "The lease id the claim returned; a secret"
                  }
                },
                "required": [
                  "lease_id"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Released, or not held"
          },
          "400": {
            "description": "Invalid JSON, an unknown field, or a malformed lease id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "No signed-in user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/_leases/renew": {
      "post": {
        "operationId": "renewLease",
        "summary": "Renew an advisory lease",
        "description": "Extends the lease and optionally replaces its status. An absent status keeps it; an empty one clears it.",
        "tags": [
          "Leases"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lease_id": {
                    "type": "string",
                    "description": "The lease id the claim returned; a secret"
                  },
                  "status": {
                    "type": "string",
                    "description": "Short note on what you are doing"
                  },
                  "ttl_seconds": {
                    "type": "integer",
                    "description": "Lease duration, 30 to 3600 (default 900)"
                  }
                },
                "required": [
                  "lease_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lease renewed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "status": {
                      "type": "string"
                    },
                    "token": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "token",
                    "expires_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, an unknown field, or invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "No signed-in user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "lease_lost: the lease expired, was released, or you lost access; claim again",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/_openapi.json": {
      "get": {
        "operationId": "getOpenAPISpec",
        "summary": "Get OpenAPI specification",
        "description": "Returns this OpenAPI 3.1 specification",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OpenAPI specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/_schema/channels": {
      "get": {
        "operationId": "getChannelSchema",
        "summary": "Describe the channel types",
        "description": "Every channel type realtime.yaml declares, with its message types, properties, actions and labels. The answer is the same for every caller; what you may do in a channel is in its `_actions`. With realtime off the list is empty.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "The channel types",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/persons": {
      "summary": "Collection of Person entities",
      "get": {
        "operationId": "listPersons",
        "summary": "List Persons",
        "tags": [
          "Person"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page (default: 25, max: 100)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort fields (comma-separated, prefix with - for descending)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[property]",
            "in": "query",
            "description": "Filter by property value (e.g., filter[status]=active)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[property][operator]",
            "in": "query",
            "description": "Filter with operator: eq, ne, contains, in",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_content",
            "in": "query",
            "description": "Include each row's markdown body (default: false; collection rows are content-free)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "relation",
            "in": "query",
            "description": "Canonical relation type; with direction=incoming, each row carries `linkable`: whether the caller may create that relation from the row's face",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Required with relation; only `incoming` is accepted",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of Persons",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            },
            "headers": {
              "Link": {
                "description": "Pagination links (RFC 5988)",
                "schema": {
                  "type": "string"
                }
              },
              "X-Page": {
                "description": "Current page number",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Per-Page": {
                "description": "Items per page",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count": {
                "description": "Total number of entities",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPerson",
        "summary": "Create a Person",
        "tags": [
          "Person"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Markdown body content"
                  },
                  "id": {
                    "type": "string",
                    "description": "Custom entity ID (auto-generated if omitted)"
                  },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "email",
                      "title"
                    ]
                  }
                },
                "required": [
                  "properties"
                ],
                "title": "Createperson",
                "description": "Request body for creating a Person"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Person created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_actions": {
                      "$ref": "#/components/schemas/EntityActions"
                    },
                    "_attachments": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Attachment"
                        }
                      },
                      "description": "Attached files by file property"
                    },
                    "_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Operator-declared entity type conversions offered from this entity"
                    },
                    "_copies": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Copy definitions offered from this face (promote, translate)"
                    },
                    "_faces": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "The other faces of this entity the reader may see"
                    },
                    "_fields": {
                      "type": "object",
                      "description": "Per-property write affordances for this reader"
                    },
                    "_lease": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "since": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "type": "string"
                        },
                        "tool": {
                          "type": "string"
                        },
                        "user": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "tool",
                        "since"
                      ],
                      "description": "The advisory lease on this entity; absent when nobody holds it"
                    },
                    "_owner": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "relation": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "description": "The entity this one is shown as part of, through an owning relation"
                    },
                    "_redacted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Properties withheld from this reader; absent when nothing is withheld"
                    },
                    "_relations": {
                      "type": "object",
                      "description": "Per-relation-type write affordances for this reader"
                    },
                    "_self": {
                      "type": "string",
                      "format": "uri-reference",
                      "description": "Self link"
                    },
                    "_task_item_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Recipes that turn a task item in this entity's body into a linked entity"
                    },
                    "_title": {
                      "type": "string",
                      "description": "Display title, resolved from the type's display property"
                    },
                    "_transitions": {
                      "type": "object",
                      "description": "Outgoing state-machine transitions per property, for this reader"
                    },
                    "_versions": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "Version token per field, for a PATCH with preconditions"
                    },
                    "_world": {
                      "type": "object",
                      "description": "Which world resolved this face, and how (single-entity GET only)"
                    },
                    "content": {
                      "type": "string",
                      "description": "Markdown body content"
                    },
                    "id": {
                      "type": "string",
                      "description": "Unique entity identifier"
                    },
                    "inaccessible": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Properties that exist but whose value cannot be read (locked content)"
                    },
                    "included": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Entity"
                      },
                      "description": "Sideloaded related entities"
                    },
                    "mentions": {
                      "type": "object",
                      "description": "Titles of the entity IDs referenced in content (single-entity GET only)"
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "email",
                        "title"
                      ]
                    },
                    "relations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": "Outgoing relations by type"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "person"
                      ],
                      "description": "Entity type"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Soft validation findings from the write that produced this response"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "title": "Person"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of created entity",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/persons/{id}": {
      "summary": "Single Person entity",
      "get": {
        "operationId": "getPerson",
        "summary": "Get a Person",
        "tags": [
          "Person"
        ],
        "parameters": [
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated relation types to include",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Person details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_actions": {
                      "$ref": "#/components/schemas/EntityActions"
                    },
                    "_attachments": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Attachment"
                        }
                      },
                      "description": "Attached files by file property"
                    },
                    "_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Operator-declared entity type conversions offered from this entity"
                    },
                    "_copies": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Copy definitions offered from this face (promote, translate)"
                    },
                    "_faces": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "The other faces of this entity the reader may see"
                    },
                    "_fields": {
                      "type": "object",
                      "description": "Per-property write affordances for this reader"
                    },
                    "_lease": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "since": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "type": "string"
                        },
                        "tool": {
                          "type": "string"
                        },
                        "user": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "tool",
                        "since"
                      ],
                      "description": "The advisory lease on this entity; absent when nobody holds it"
                    },
                    "_owner": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "relation": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "description": "The entity this one is shown as part of, through an owning relation"
                    },
                    "_redacted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Properties withheld from this reader; absent when nothing is withheld"
                    },
                    "_relations": {
                      "type": "object",
                      "description": "Per-relation-type write affordances for this reader"
                    },
                    "_self": {
                      "type": "string",
                      "format": "uri-reference",
                      "description": "Self link"
                    },
                    "_task_item_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Recipes that turn a task item in this entity's body into a linked entity"
                    },
                    "_title": {
                      "type": "string",
                      "description": "Display title, resolved from the type's display property"
                    },
                    "_transitions": {
                      "type": "object",
                      "description": "Outgoing state-machine transitions per property, for this reader"
                    },
                    "_versions": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "Version token per field, for a PATCH with preconditions"
                    },
                    "_world": {
                      "type": "object",
                      "description": "Which world resolved this face, and how (single-entity GET only)"
                    },
                    "content": {
                      "type": "string",
                      "description": "Markdown body content"
                    },
                    "id": {
                      "type": "string",
                      "description": "Unique entity identifier"
                    },
                    "inaccessible": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Properties that exist but whose value cannot be read (locked content)"
                    },
                    "included": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Entity"
                      },
                      "description": "Sideloaded related entities"
                    },
                    "mentions": {
                      "type": "object",
                      "description": "Titles of the entity IDs referenced in content (single-entity GET only)"
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "email",
                        "title"
                      ]
                    },
                    "relations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": "Outgoing relations by type"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "person"
                      ],
                      "description": "Entity type"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Soft validation findings from the write that produced this response"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "title": "Person"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Entity version tag",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (ETag match)"
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updatePerson",
        "summary": "Update a Person",
        "tags": [
          "Person"
        ],
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "description": "ETag for optimistic locking",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Markdown body content"
                  },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "email",
                      "title"
                    ]
                  },
                  "relations": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "$ref": "#/components/schemas/RelationsUpdate"
                        }
                      ],
                      "description": "Either a legacy array of target IDs OR a JSON:API §9 wrapper {data: [...]}"
                    },
                    "description": "Outgoing relations by relation type. Mixing legacy and JSON:API shapes in one body returns 400."
                  }
                },
                "title": "Updateperson",
                "description": "Request body for updating a Person (PATCH - partial update). See docs/data-entry/api-reference.md for the full contract."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Person updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_actions": {
                      "$ref": "#/components/schemas/EntityActions"
                    },
                    "_attachments": {
                      "type": "object",
                      "additionalProperties": {
