    "/api/v1/persons/{id}/_lease": {
      "post": {
        "operationId": "claimPerson",
        "summary": "Claim an advisory lease on a Person",
        "description": "Tells people and agents you are working on the entity. Needs read and update access. Leases do not block writes. Keep lease_id: it is returned only here, and POST /api/v1/_leases/renew and POST /api/v1/_leases/release need it.",
        "tags": [
          "Person"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Tells apart agents running as the same user"
                  },
                  "status": {
                    "type": "string",
                    "description": "Short note on what you are doing"
                  },
                  "ttl_seconds": {
                    "type": "integer",
                    "description": "Lease duration, 30 to 3600 (default 900)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lease claimed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "lease_id": {
                      "type": "string"
                    },
                    "token": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "lease_id",
                    "token",
                    "expires_at"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, an unknown field, or invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed to update the entity, or no signed-in user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The entity is held (lease_held, naming the holder), or you hold too many leases (lease_limit)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "holder": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string"
                            },
                            "tool": {
                              "type": "string"
                            },
                            "user": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "user",
                            "tool"
                          ]
                        },
                        "since": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    }
                  ],
                  "description": "A problem. When the type ends in lease_held, it also names the holder and the live lease; a lease_limit problem has the problem fields only."
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "A bare id of a faced type; address one face",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The lease store is full; retry later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID, or ID@face",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/persons/{id}/_presence": {
      "get": {
        "operationId": "getPresencePerson",
        "summary": "List who else has a Person open",
        "description": "The other people with a live subscription to this path, oldest first, at most 20. A viewer stays listed for 15 seconds after they close it. You are never listed, from any tool. This GET does not add you; subscribe to the path on the live event stream for that.",
        "tags": [
          "Person"
        ],
        "responses": {
          "200": {
            "description": "The viewers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "more": {
                      "type": "integer",
                      "description": "Viewers past the 20 listed"
                    },
                    "viewers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "since": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "tool": {
                            "type": "string"
                          },
                          "user": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "user",
                          "tool",
                          "since"
                        ]
                      }
                    }
                  },
                  "required": [
                    "viewers",
                    "more"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID, or ID@face",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "world",
          "in": "query",
          "description": "World that picks the face",
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/v1/persons/{id}/mentioned-by": {
      "get": {
        "operationId": "getPersonMentionedBy",
