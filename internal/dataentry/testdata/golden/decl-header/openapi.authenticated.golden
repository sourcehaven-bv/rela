  "components": {
    "schemas": {
      "AnalysisIssue": {
        "type": "object",
        "properties": {
          "check_type": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        }
      },
      "AnalysisResult": {
        "type": "object",
        "properties": {
          "by_check": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "errors": {
            "type": "integer"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisIssue"
            }
          },
          "warnings": {
            "type": "integer"
          }
        }
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "format": "uri-reference",
            "description": "Download link"
          },
          "id": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "description": "Size in bytes"
          }
        },
        "required": [
          "id",
          "filename",
          "size",
          "contentType",
          "href"
        ]
      },
      "ChannelSchema": {
        "type": "object",
        "properties": {
          "channel_types": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "enum": [
                    "family",
                    "face"
                  ]
                },
                "attach_to": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cardinality": {
                  "type": "string",
                  "enum": [
                    "one",
                    "many"
                  ]
                },
                "create_label": {
                  "type": "string",
                  "description": "create.label of a cardinality many type; absent when not set"
                },
                "label": {
                  "type": "string",
                  "description": "The label from realtime.yaml, or the name when none is set; never empty"
                },
                "lifecycle": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "description": "The label from realtime.yaml, or the name when none is set; never empty"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "label"
                    ]
                  },
                  "description": "The declared lifecycle operations, in the order close, reopen, archive, delete"
                },
                "message_types": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "actions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "description": "The label from realtime.yaml, or the name when none is set; never empty"
                            },
                            "name": {
                              "type": "string"
                            },
                            "promote_to": {
                              "type": "string",
                              "description": "The entity type a promoting action creates"
                            }
                          },
                          "required": [
                            "name",
                            "label"
                          ]
                        }
                      },
                      "label": {
                        "type": "string",
                        "description": "The label from realtime.yaml, or the name when none is set; never empty"
                      },
                      "name": {
                        "type": "string"
                      },
                      "persist": {
                        "type": "string",
                        "enum": [
                          "log",
                          "ephemeral"
                        ]
                      },
                      "properties": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "enum": {
                              "type": "string",
                              "description": "The schema.yaml enum type of an enum property"
                            },
                            "label": {
                              "type": "string",
                              "description": "The label from realtime.yaml, or the name when none is set; never empty"
                            },
                            "max": {
                              "type": "integer",
                              "description": "Most characters (Unicode code points) of a string or markdown value"
                            },
                            "name": {
                              "type": "string"
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "to": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "description": "Entity types a ref property may name"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "string",
                                "markdown",
                                "integer",
                                "boolean",
                                "date",
                                "datetime",
                                "ref",
                                "enum"
                              ]
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "name",
                            "label",
                            "type"
                          ]
                        },
                        "description": "Required first, then by name"
                      },
                      "reply": {
                        "type": "boolean",
                        "description": "Whether a message of the type may reply to another"
                      },
                      "ttl_seconds": {
                        "type": "integer",
                        "description": "How long an ephemeral message lives"
                      }
                    },
                    "required": [
                      "name",
                      "label",
                      "persist",
                      "reply",
                      "properties",
                      "actions"
                    ]
                  }
                },
                "name": {
                  "type": "string"
                },
                "remove_reason_required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "label",
                "attach_to",
                "anchor",
                "cardinality",
                "remove_reason_required",
                "lifecycle",
                "message_types"
              ]
            }
          }
        },
        "required": [
          "channel_types"
        ]
      },
      "Config": {
        "type": "object",
        "properties": {
          "app": {
            "type": "object"
          },
          "calendars": {
            "type": "object"
          },
          "dashboard": {
            "type": "object"
