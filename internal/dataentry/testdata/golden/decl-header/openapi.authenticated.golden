            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "PropertyDef": {
        "type": "object",
        "properties": {
          "default": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "list": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RelationType": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "max_incoming": {
            "type": "integer"
          },
          "max_outgoing": {
            "type": "integer"
          },
          "min_incoming": {
            "type": "integer"
          },
          "min_outgoing": {
            "type": "integer"
          },
          "owning": {
            "type": "boolean"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RelationsUpdate": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceIdentifier"
            }
          }
        },
        "required": [
          "data"
        ],
        "description": "Desired state for one relation type. Sending data: [] removes every edge of this relation type — see the data-loss footgun callout in docs/data-entry/api-reference.md."
      },
      "ResourceIdentifier": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Per-edge body (only for relation types with content: true)"
          },
          "id": {
            "type": "string",
            "description": "Target entity ID"
          },
          "meta": {
            "type": "object",
            "additionalProperties": {},
            "description": "Per-edge meta properties (upsert)"
          },
          "meta_unset": {
            "type": "array",
            "items": {
