        }
      ]
    },
    "/api/v1/tickets/{id}/_attachments/{property}": {
      "put": {
        "operationId": "putTicketAttachment",
        "summary": "Upload a file to a Ticket",
        "description": "Attaches a file to a file property, appending up to the property's `max` (replacing the file when `max` is 1). Send the file as the raw body with `filename`, or as a multipart form with the file in field `file`. The upload policy of the property (MIME allowlist, scan, size limit) applies.",
        "tags": [
          "Ticket"
        ],
        "parameters": [
          {
            "name": "filename",
            "in": "query",
            "description": "The file's name; required with a raw body, ignored with a multipart form",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File attached; the updated Ticket",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_actions": {
                      "$ref": "#/components/schemas/EntityActions"
                    },
                    "_attachments": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Attachment"
                        }
                      },
                      "description": "Attached files by file property"
                    },
                    "_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Operator-declared entity type conversions offered from this entity"
                    },
                    "_copies": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Copy definitions offered from this face (promote, translate)"
                    },
                    "_faces": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "The other faces of this entity the reader may see"
                    },
                    "_fields": {
                      "type": "object",
                      "description": "Per-property write affordances for this reader"
                    },
                    "_lease": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "since": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "type": "string"
                        },
                        "tool": {
                          "type": "string"
                        },
                        "user": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "tool",
                        "since"
                      ],
                      "description": "The advisory lease on this entity; absent when nobody holds it"
                    },
                    "_owner": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "relation": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "description": "The entity this one is shown as part of, through an owning relation"
                    },
                    "_redacted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Properties withheld from this reader; absent when nothing is withheld"
                    },
                    "_relations": {
                      "type": "object",
                      "description": "Per-relation-type write affordances for this reader"
                    },
                    "_self": {
                      "type": "string",
                      "format": "uri-reference",
                      "description": "Self link"
                    },
                    "_task_item_conversions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Recipes that turn a task item in this entity's body into a linked entity"
                    },
                    "_title": {
                      "type": "string",
                      "description": "Display title, resolved from the type's display property"
                    },
                    "_transitions": {
                      "type": "object",
                      "description": "Outgoing state-machine transitions per property, for this reader"
                    },
                    "_versions": {
                      "type": "object",
                      "properties": {
                        "content": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "Version token per field, for a PATCH with preconditions"
                    },
                    "_world": {
                      "type": "object",
                      "description": "Which world resolved this face, and how (single-entity GET only)"
                    },
                    "content": {
                      "type": "string",
                      "description": "Markdown body content"
                    },
                    "id": {
                      "type": "string",
                      "description": "Unique entity identifier"
                    },
                    "inaccessible": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Properties that exist but whose value cannot be read (locked content)"
                    },
                    "included": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Entity"
                      },
                      "description": "Sideloaded related entities"
                    },
                    "mentions": {
                      "type": "object",
                      "description": "Titles of the entity IDs referenced in content (single-entity GET only)"
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "budget": {
                          "type": "string"
                        },
                        "closed_on": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "due": {
                          "type": "string",
                          "format": "date"
                        },
                        "note": {
                          "type": "string"
                        },
                        "screenshot": {
                          "type": "string",
                          "format": "uri-reference"
                        },
                        "secret": {
                          "type": "string"
                        },
                        "start": {
                          "type": "string",
                          "format": "date"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "closed",
                            "archived"
                          ]
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title"
                      ]
                    },
                    "relations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": "Outgoing relations by type"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "ticket"
                      ],
                      "description": "Entity type"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Soft validation findings from the write that produced this response"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "title": "Ticket"
                }
              }
            }
          },
          "400": {
            "description": "No file, or no file name with a raw body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed to update the entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Entity or file property not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The property already holds its maximum number of files",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "File exceeds the size limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Raw body sent with a Content-Encoding",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "File rejected by the upload policy",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Upload capacity reached; retry later",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Entity ID",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "property",
          "in": "path",
          "description": "The file property",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "screenshot"
            ]
          }
        }
      ]
