                          "type": "string"
                        },
                        "relation": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "description": "The entity this one is shown as part of, through an owning relation"
                    },
                    "_redacted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Properties withheld from this reader; absent when nothing is withheld"
                    },
