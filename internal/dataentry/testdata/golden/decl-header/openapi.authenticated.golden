                  "type": "integer"
                }
              },
              "X-Per-Page": {
                "description": "Items per page",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Total-Count": {
                "description": "Total number of entities",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
