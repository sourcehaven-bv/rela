                    "content": {
                      "type": "string",
                      "description": "Markdown body content"
                    },
                    "id": {
                      "type": "string",
                      "description": "Unique entity identifier"
                    },
                    "inaccessible": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Properties that exist but whose value cannot be read (locked content)"
                    },
                    "included": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Entity"
                      },
                      "description": "Sideloaded related entities"
                    },
                    "mentions": {
                      "type": "object",
                      "description": "Titles of the entity IDs referenced in content (single-entity GET only)"
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "budget": {
                          "type": "string"
                        },
                        "closed_on": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "due": {
                          "type": "string",
                          "format": "date"
                        },
                        "note": {
                          "type": "string"
                        },
                        "screenshot": {
                          "type": "string",
                          "format": "uri-reference"
                        },
                        "secret": {
                          "type": "string"
                        },
                        "start": {
                          "type": "string",
                          "format": "date"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "closed",
                            "archived"
                          ]
                        },
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title"
                      ]
                    },
                    "relations": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": "Outgoing relations by type"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "ticket"
                      ],
                      "description": "Entity type"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Soft validation findings from the write that produced this response"
                    }
                  },
                  "required": [
                    "id",
                    "type"
                  ],
                  "title": "Ticket"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of cloned entity",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/problem+json": {
