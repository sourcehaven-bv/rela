      "post": {
        "operationId": "createPersonWatchesRelation",
        "summary": "Create  relation",
        "description": "A person watches a ticket. Confers the watcher role on it.. Target must be one of: ticket",
        "tags": [
          "Person",
          "Relations"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRelationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Relation created"
          },
          "404": {
            "description": "Source or target entity not found",
