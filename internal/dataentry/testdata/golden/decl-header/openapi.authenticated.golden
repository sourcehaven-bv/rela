        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Target entity ID"
          },
          "meta": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Relation metadata properties"
          }
        },
        "required": [
          "id"
        ],
        "title": "CreateRelation"
      },
      "CustomType": {
        "type": "object",
        "properties": {
          "default": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Entity": {
        "type": "object",
        "properties": {
          "_owner": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "description": "The entity this one is shown as part of, through an owning relation"
          },
          "_self": {
            "type": "string",
            "format": "uri-reference"
          },
          "content": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          },
          "relations": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "type": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "required": [
          "id",
          "type"
        ],
        "description": "A rela entity"
      },
      "EntityActions": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        },
        "description": "Write affordances for this reader: verb (create, update, delete, rename) or action:\u003cid\u003e to whether it is offered. A UI hint; the server re-authorizes every write."
      },
      "EntityType": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "id_prefix": {
            "type": "string"
          },
          "id_type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "plural": {
            "type": "string"
          },
          "primary": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/PropertyDef"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "conflicts": {
            "type": "object",
            "description": "On a 412: the fields whose stored version differs from the precondition"
          },
          "detail": {
            "type": "string",
            "description": "Detailed explanation"
          },
          "entity_id": {
            "type": "string",
            "description": "On a 500 conversion_incomplete: the entity the conversion created before a later step failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "faces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "On a face_required refusal: the addresses (ID@face) to retry with"
          },
          "instance": {
            "type": "string",
            "description": "URI reference to the specific occurrence"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary"
          },
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Error type URI"
          },
          "versions": {
            "type": "object",
            "description": "On a 412: the current version token of every visible field"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem Details",
        "description": "RFC 7807 Problem Details for HTTP APIs"
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string"
              }
            }
          }
        }
      },
      "ListMeta": {
        "type": "object",
        "properties": {
