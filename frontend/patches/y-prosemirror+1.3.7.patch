+ */
+const PM_MARKS = '__pmMarks'
+
+/**
+ * rela: the attributes a node is stored with: all of its attributes, null
+ * included, plus its marks under PM_MARKS when it has any. Attributes the
+ * node spec lists in `localAttrs` are never stored: they belong to one view
+ * (rela's per-principal entity titles) and must not reach other peers.
+ * @param {any} pnode
+ * @return {Object<string,any>}
+ */
+const pNodeYAttrs = (pnode) => {
+  /** @type {Object<string,any>} */
+  const out = {}
+  const local = pnode.type.spec.localAttrs
+  for (const key in pnode.attrs) {
+    if (key === 'ychange' || (Array.isArray(local) && local.includes(key))) continue
+    out[key] = pnode.attrs[key]
+  }
+  if (pnode.marks && pnode.marks.length) {
+    out[PM_MARKS] = pnode.marks.map((/** @type {any} */ m) => m.toJSON())
+  }
+  return out
+}
